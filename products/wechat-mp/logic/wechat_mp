    "btn_reprobe_permission": "refresh_publish_permission",
    "btn_submit_publish": "submit_publish",
    "btn_query_publish": "query_publish_status",
    "btn_copy_publish_status": "copy_publish_status",
}
CHANGE_NODES = {
    "nav_form": "page_change",
    "account_form": "account_change",
    "theme_form": "theme_change",
    "composer_source_form": "markdown_change",
    "composer_meta_form": "meta_change",
    "publish_form": "publish_form_change",
}
ACTION_FALLBACK = {
    "use_asset_as_cover": act_use_asset_as_cover,
    "copy_asset_media_id": act_copy_asset_media_id,
    "use_draft_as_target": act_use_draft_as_target,
    "delete_draft": act_delete_draft,
}


def _dispatch(state, envelope):
    node_id = str(envelope.get("node_id") or "")
    event = str(envelope.get("event") or "")
    base = node_id.split("#")[0]
    payload = envelope.get("payload") or {}

    action = None
    if event == "tap" and base in TAP_NODES:
        action = TAP_NODES[base]
    elif event == "change" and base in CHANGE_NODES:
        action = CHANGE_NODES[base]
    elif event in ("submit",) and base == "account_form":
        action = "save_credentials"
    elif event in ("submit",) and base == "composer_meta_form":
        action = "save_draft"
    elif event in ("submit",) and base == "publish_form":
        action = "query_publish_status"
    elif event in ("select",) and base in ("drafts_list", "drafts_row"):
        action = "select_draft"
    elif event in ("confirm",) and base == "dialog_confirm_delete":
        action = "confirm_delete_draft"
    elif event in ("cancel",) and base == "dialog_confirm_delete":
        action = "cancel_delete_draft"
    elif event in ("action", "menu", "custom") and isinstance(payload.get("action"), str):
        action = payload["action"]
    elif base in ("media_row", "drafts_row") and isinstance(payload.get("action"), str):
        action = payload["action"]

    fn = None
    if action:
        fn = HANDLERS.get(action, (None, None))[0] or ACTION_FALLBACK.get(action)
    if fn is None:
        _absorb(envelope, state)
        APP.log("warn", "未识别的事件 %s@%s" % (node_id, event))
        _notice(state, "未识别的操作：%s@%s" % (node_id, event), True)
        return state
    return fn(state, envelope)


def on_event(envelope):
    """兜底事件入口：SDK 未命中 (node_id, event) 绑定时调用。"""
    return _dispatch(APP.state, envelope)


def _register():
    """把 UI 文档声明的绑定注册到 SDK（宿主按 (node_id, event) 命中）。"""
    for node_id, (action, event) in NODE_ACTIONS.items():
        fn = HANDLERS.get(action, (None, None))[0]
        if fn is not None:
            APP.bind(node_id, event, fn)
    for node_id, action in TAP_NODES.items():
        fn = HANDLERS.get(action, (None, None))[0]
        if fn is not None:
            APP.bind(node_id, "tap", fn)
    # 列表行 / 卡片动作（node_id 带 #序号，绑定前缀兜底由 on_event 处理）


