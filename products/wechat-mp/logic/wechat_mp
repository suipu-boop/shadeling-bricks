def act_test_connection(state, envelope):
    _absorb(envelope, state)
    app_id = str(state.get("app_id") or "").strip()
    secret = str(state.get("secret") or "").strip()
    rt = state.setdefault("_rt", {})
    if not app_id or not secret:
        _notice(state, "测试连接失败：请先填写并保存 AppID / AppSecret", True)
        return state
    lines = []
    lines.append(_report_line(1, "凭据完整性", True, "AppID %s…（%d 位）/ AppSecret 已填写"
                              % (app_id[:6], len(app_id))))
    store = _store()
    lines.append(_report_line(2, "凭据落盘", True, "私有目录 0600：%s%s"
                              % (store.account_path,
                                 "（含旧目录接管）" if store.adopted_from_legacy else "")))
    if not TRANSPORT.available:
        lines.append(_report_line(3, "接口连通", False,
                                  "未执行 —— %s" % TRANSPORT.why_unavailable()))
        rt["account_report"] = "\n".join(lines)
        rt["publish_state"] = "unknown"
        rt["publish_reason"] = "写类网络能力（G4）未授予，未发起 freepublish 探测。"
        _notice(state, "测试连接未执行：写类网络能力（G4）未授予（详见三步检测报告）", True)
        return state

    rt["account_testing"] = True
    _notice(state, "正在测试连接…")

    def after_token(err):
        rt["account_testing"] = False
        if err:
            lines.append(_report_line(3, "接口连通", False, err.message))
            rt["account_report"] = "\n".join(lines)
            rt["publish_state"] = "unknown"
            rt["publish_reason"] = err.message
            _notice(state, "测试连接失败：%s" % err.message, True)
            _push()
            return
        lines.append(_report_line(3, "接口连通", True, "access_token 获取成功（有效期约 2 小时）"))
        rt["account_report"] = "\n".join(lines)

        def after_probe(payload, err2):
            if err2:
                if err2.code in NO_PERMISSION_CODES:
                    rt["publish_state"] = "denied"
                    rt["publish_reason"] = ("发布能力不可用：%s；按契约已隐藏发布入口，"
                                            "仅保留草稿箱能力。" % err2.message)
                else:
                    rt["publish_state"] = "unknown"
                    rt["publish_reason"] = "freepublish 探测失败：%s" % err2.message
                _notice(state, rt["publish_reason"], err2.code not in NO_PERMISSION_CODES)
