}


class WeChatClient:
    """微信接口调用（token 串行缓存 + 失效重取 + 错误码中文映射）。同步语义由回调表达。"""

    def __init__(self, transport, store, credentials=None):
        self.transport = transport
        self.store = store
        self.credentials = credentials or {}
        self.token = ""
        self.token_expires_at = 0.0
        cached = store.load_token()
        if cached.get("access_token") and float(cached.get("expires_at") or 0) > time.time():
            self.token = str(cached["access_token"])
            self.token_expires_at = float(cached["expires_at"])

    # -- token -------------------------------------------------------------

    def token_valid(self):
        return bool(self.token) and self.token_expires_at > time.time() + 30

    def ensure_token(self, on_done):
        if self.token_valid():
            on_done(None)
            return

        def after(res, err):
            if err:
                on_done(err)
                return
            if not res:
                on_done(TransportError("protocol", "token 接口返回空应答"))
                return
            payload = res.get("json") or {}
            err2 = _wechat_result_error(payload)
            if err2:
                on_done(err2)
                return
            self.token = str(payload.get("access_token") or "")
            expires_in = int(payload.get("expires_in") or 7200)
            self.token_expires_at = time.time() + expires_in
            self.store.save_token(self.token, self.token_expires_at, self.credentials.get("app_id") or "")
            on_done(None)

        self._request({
            "host": HOST_WHITELIST,
            "method": "GET",
            "path": PATHS["token"],
            "query": {"grant_type": "client_credential",
                      "appid": self.credentials.get("app_id") or "",
                      "secret": self.credentials.get("secret") or ""},
            "timeout_s": 20,
        }, after)

    def _request(self, req, on_done):
        """统一出网入口：**调用即留痕**（host / method / path），回执补响应码。

        审计只记键名与字节数（不记 query / body 取值，凭据不入日志，评审 §4）。
        """
        form = "none"
        if req.get("multipart"):
            form = "multipart(%d 字节)" % int((req.get("multipart") or {}).get("size") or 0)
        elif req.get("body") is not None:
            form = "json"
        _audit("host=%s method=%s path=%s body=%s" % (req["host"], req["method"],
                                                      req["path"], form))

        def after(res=None, err=None):
            if err is not None:
                _audit("host=%s path=%s ← ok=false code=%s" % (req["host"], req["path"],
                                                               getattr(err, "code", None)))
            else:
                _audit("host=%s path=%s ← ok=true status=%s" % (req["host"], req["path"],
                                                                (res or {}).get("status")))
            on_done(res, err)

        self.transport.request(req, after)

    def expire_token(self):
        self.token = ""
        self.token_expires_at = 0.0

    # -- 通用请求 -----------------------------------------------------------

    def call(self, path, body=None, query=None, multipart=None, need_token=True, on_done=None):
        def make_after(allow_retry):
            """构造响应处理器；重试路径传 allow_retry=False，避免失效重试再触发重试。"""
            def after(res, err2):
                if err2:
                    on_done(None, err2)
                    return
                payload = res.get("json")
                err3 = _wechat_result_error(payload)
                if err3 and err3.code in TOKEN_INVALID_CODES and need_token and allow_retry:
                    # 40001 / 40014 / 42001：失效重取一次，重试仍走同一响应处理器（含错误码判定）
                    self.expire_token()

                    def retry(err4):
                        if err4:
                            on_done(None, err4)
                            return
                        self._send(path, body, query, multipart, need_token, make_after(False))

                    self.ensure_token(retry)
                    return
                if err3:
                    on_done(None, err3)
                    return
                on_done(payload, None)
            return after

        def proceed(err):
            if err:
                on_done(None, err)
                return
            self._send(path, body, query, multipart, need_token, make_after(True))

        if need_token:
            self.ensure_token(proceed)
        else:
            proceed(None)

    def _send(self, path, body, query, multipart, need_token, on_done):
        req = {"host": HOST_WHITELIST, "method": "POST" if body is not None or multipart else "GET",
               "path": path, "query": dict(query or {}), "headers": {}, "timeout_s": 30}
        if need_token:
            req["query"]["access_token"] = self.token
        if body is not None:
            req["body"] = body
        if multipart:
            req["multipart"] = multipart
        self._request(req, on_done)

    # -- 业务接口 -----------------------------------------------------------

    def fetch_token_probe(self, on_done):
        """三步检测的第 ② 步：取 token（等价于账号可用性探测）。"""
        self.expire_token()
        self.ensure_token(on_done)

    def material_count(self, on_done):
        self.call(PATHS["material_count"], query={}, on_done=on_done)

    def upload_material(self, file_path, file_bytes, mime, on_done):
        media_id = ""
        multipart = {"name": "media", "filename": os.path.basename(file_path),
                     "mime": mime, "size": len(file_bytes), "content": file_bytes}
        self.call(PATHS["material_add"], query={"type": "image"}, multipart=multipart, on_done=on_done)

    def draft_add(self, articles, on_done):
        self.call(PATHS["draft_add"], body={"articles": articles}, on_done=on_done)

    def draft_batchget(self, offset, count, on_done):
        self.call(PATHS["draft_batchget"], body={"offset": int(offset), "count": int(count),
                                                 "no_content": 1}, on_done=on_done)

    def draft_delete(self, media_id, on_done):
        self.call(PATHS["draft_delete"], body={"media_id": media_id}, on_done=on_done)

    def publish_probe(self, on_done):
        self.call(PATHS["publish_batchget"], body={"offset": 0, "count": 1}, on_done=on_done)

    def publish_submit(self, media_id, on_done):
        self.call(PATHS["publish_submit"], body={"media_id": media_id}, on_done=on_done)

    def publish_get(self, publish_id, on_done):
        self.call(PATHS["publish_get"], body={"publish_id": publish_id}, on_done=on_done)


