def act_account_change(state, envelope):
    hits = _absorb(envelope, state)
    if not hits:
        for key in ("app_id", "app_secret", "secret"):
            if key in (envelope.get("payload") or {}):
                state[FIELD_TO_STATE.get(key, key)] = (envelope["payload"] or {})[key]
    if state.get("app_id") or state.get("secret"):
        _notice(state, "凭据未保存：点「保存凭据」写入本机私有目录（0600）")
