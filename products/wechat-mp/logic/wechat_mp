def _style_list_container(t):
    return "margin:0 0 %dpx;padding-left:22px;" % t["paragraph_spacing"]


def _style_heading(t, level):
    level = max(1, min(6, int(level)))
    size = t["font_size"] + max(0, (7 - level) * 2)
    base = ("margin:28px 0 16px;font-size:%dpx;font-weight:700;line-height:1.4;color:%s;"
            % (size, t["text"]))
    if t["heading"] == "bar":
        return base + "padding-left:12px;border-left:4px solid %s;" % t["accent"]
    if t["heading"] == "underline":
        return base + "padding-bottom:8px;border-bottom:1px solid %s;" % t["divider"]
    return base


# --- 行内语法 ---------------------------------------------------------------

_RE_IMG = re.compile(r"!\[([^\]]*)\]\(([^)\s]+)\)")
_RE_LINK = re.compile(r"\[([^\]]+)\]\(([^)\s]+)\)")
_RE_BOLD = re.compile(r"\*\*([^*]+)\*\*")
_RE_STRIKE = re.compile(r"~~([^~]+)~~")
_RE_CODE = re.compile(r"`([^`]+)`")
_RE_ITALIC = re.compile(r"(?<!\*)\*([^*\n]+)\*(?!\*)")


def _inline(text, t):
    """行内语法 → 内联样式标签（微信编辑器剥离 class，样式必须内联）。"""
    out = html.escape(text.strip())
    out = _RE_CODE.sub(lambda m: '<code style="%s">%s</code>' % (_style_inline_code(t), m.group(1)), out)
    out = _RE_IMG.sub(lambda m: '<img src="%s" alt="%s" style="%s"/>'
                      % (m.group(2), m.group(1), _style_image()), out)
    out = _RE_LINK.sub(lambda m: '<a href="%s" style="%s">%s</a>'
                       % (m.group(2), _style_link(t), m.group(1)), out)
    out = _RE_BOLD.sub(lambda m: "<strong>%s</strong>" % m.group(1), out)
    out = _RE_STRIKE.sub(lambda m: "<del>%s</del>" % m.group(1), out)
    out = _RE_ITALIC.sub(lambda m: "<em>%s</em>" % m.group(1), out)
    return out


def render_markdown(markdown, theme_name):
    """Markdown → 微信兼容 HTML（块级 + 行内全内联样式；空输入返回空串）。"""
    t = theme_of(theme_name)
    src = (markdown or "").replace("\r\n", "\n").replace("\r", "\n")
    if not src.strip():
        return ""
    lines = src.split("\n")
    blocks = []
    i = 0
    total = len(lines)
    while i < total:
        line = lines[i]
        stripped = line.strip()
        if stripped.startswith("```"):
            i += 1
            buf = []
            while i < total and not lines[i].strip().startswith("```"):
                buf.append(lines[i])
                i += 1
            i += 1  # 吞掉收尾围栏（缺失时也前进一行，避免死循环）
            body = html.escape("\n".join(buf))
            blocks.append('<pre style="%s"><code>%s</code></pre>' % (_style_code_block(t), body))
            continue
        if not stripped:
            i += 1
            continue
        if re.match(r"^(---+|\*\*\*+|___+)$", stripped):
            blocks.append('<hr style="%s"/>' % _style_divider(t))
            i += 1
            continue
        m = re.match(r"^(#{1,6})\s+(.*)$", stripped)
        if m:
            level = len(m.group(1))
            blocks.append('<h%d style="%s">%s</h%d>'
                          % (level, _style_heading(t, level), _inline(m.group(2), t), level))
            i += 1
            continue
        if stripped.startswith(">"):
            buf = []
            while i < total and lines[i].strip().startswith(">"):
                buf.append(lines[i].strip()[1:].strip())
                i += 1
            blocks.append('<blockquote style="%s"><p style="%s">%s</p></blockquote>'
                          % (_style_quote(t), _style_paragraph(t), _inline(" ".join(buf), t)))
            continue
        m = re.match(r"^[-*+]\s+(.*)$", stripped)
        if m:
            items = []
            while i < total:
                mm = re.match(r"^[-*+]\s+(.*)$", lines[i].strip())
                if not mm:
                    break
                items.append('<li style="%s">%s</li>' % (_style_list_item(t), _inline(mm.group(1), t)))
                i += 1
            blocks.append('<ul style="%s">%s</ul>' % (_style_list_container(t), "".join(items)))
            continue
        m = re.match(r"^\d+[.)]\s+(.*)$", stripped)
        if m:
            items = []
            while i < total:
                mm = re.match(r"^\d+[.)]\s+(.*)$", lines[i].strip())
                if not mm:
                    break
                items.append('<li style="%s">%s</li>' % (_style_list_item(t), _inline(mm.group(1), t)))
                i += 1
            blocks.append('<ol style="%s">%s</ol>' % (_style_list_container(t), "".join(items)))
            continue
        buf = [stripped]
        i += 1
        while i < total:
            nxt = lines[i].strip()
            if not nxt or re.match(r"^(#{1,6}\s|[-*+]\s|\d+[.)]\s|>|```|---+$|\*\*\*+$)", nxt):
                break
            buf.append(nxt)
            i += 1
        blocks.append('<p style="%s">%s</p>' % (_style_paragraph(t), _inline(" ".join(buf), t)))
    body = "\n".join(blocks)
    return '<section style="%s">\n%s\n</section>' % (_style_body(t), body)


