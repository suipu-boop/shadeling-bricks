def _style_body(t):
    return ("font-family:%s;font-size:%dpx;line-height:%s;color:%s;letter-spacing:0.5px;"
            % (t["font_family"], t["font_size"], t["line_height"], t["text"]))


def _style_paragraph(t):
    return ("margin:0 0 %dpx;font-size:%dpx;line-height:%s;color:%s;"
            % (t["paragraph_spacing"], t["font_size"], t["line_height"], t["text"]))


def _style_quote(t):
    return ("margin:0 0 %dpx;padding:12px 16px;border-left:3px solid %s;background:%s;"
            "color:%s;font-size:%dpx;line-height:%s;"
            % (t["paragraph_spacing"], t["accent"], t["quote_bg"], t["secondary"],
