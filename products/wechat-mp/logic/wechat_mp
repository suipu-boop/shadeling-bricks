class TransportError(Exception):
    def __init__(self, kind, message, code=None):
        super().__init__(message)
        self.kind = kind          # unavailable / protocol / transport / wechat
        self.message = message
        self.code = code


def _log(text):
    """普通日志（本地操作；不含凭据取值）。"""
    try:
        APP.log("info", text)
    except Exception:
        sys.stderr.write("%s\n" % text)


def _audit(text):
    """审计行：仅用于**出网调用**留痕（host / method / path / 响应码）。

    契约 §5.3.8 与受控网络写评审：每次 `agent.web.write` 出网必须留痕，
    且审计只记键名与字节数、不出现凭据取值；本地文件操作走 `_log` 不入审计。
    stderr 直通，不混入 stdout。
    """
    try:
        APP.log("info", "[audit] %s" % text)
    except Exception:
        sys.stderr.write("[audit] %s\n" % text)


class BaseTransport:
    available = False

    def request(self, req, on_done):  # pragma: no cover - 抽象
        raise NotImplementedError


class CapabilityTransport(BaseTransport):
    """经 host 能力 ``agent.web.write`` 发起请求（逻辑进程不直连网络）。"""

    CAPABILITY = "agent.web.write"

    def __init__(self):
        self.jobs = {}

    @property
    def available(self):
        return self.CAPABILITY in (getattr(APP, "granted_permissions", None) or [])

    def why_unavailable(self):
        return ("写类网络能力 %s（G4，高危）未授予：测试连接 / 素材上传 / 草稿增删刷新 / "
                "发布探测与提交 暂不可用；该能力获批后无需改包即可恢复。" % self.CAPABILITY)

    def request(self, req, on_done):
        """on_done(res, err)：与 WeChatClient 的回调口径一致（res=None 表示失败）。"""
        if not self.available:
            on_done(None, TransportError("unavailable", self.why_unavailable(), code=4309))
            return
        if req["host"] != HOST_WHITELIST:
            on_done(None, TransportError("protocol", "目标主机不在白名单：%s" % req["host"]))
            return
        audit = "%s %s%s body=%s" % (req["method"], req["host"], req["path"],
                                     "json" if req.get("body") is not None else "none")
        if req.get("multipart"):
            size = int(req["multipart"].get("size") or 0)
            if size > MULTIPART_LIMIT_BYTES:
                on_done(None, TransportError("protocol", "multipart 超过 10MB 上限：%d 字节" % size))
                return
            audit += " multipart=%s(%d 字节)" % (req["multipart"].get("name"), size)
        _audit(audit)
        payload = {
            "host": req["host"],
            "method": req["method"],
            "path": req["path"],
            "query": req.get("query") or {},
            "headers": req.get("headers") or {"Content-Type": "application/json"},
            "timeout_s": int(req.get("timeout_s") or 30),
        }
        if req.get("body") is not None:
            payload["body"] = req["body"]
        if req.get("multipart"):
            payload["multipart"] = req["multipart"]
        call_id = APP.call_capability(self.CAPABILITY, payload)
        if call_id:
            self.jobs[call_id] = on_done
        else:
            on_done(None, TransportError("transport", "能力调用未返回 call_id"))

    def resolve(self, call_id, result, error):
        cb = self.jobs.pop(call_id, None)
        if cb is None:
            return False
        if error:
            cb(None, TransportError("transport", str(error.get("message") or error),
                                    code=error.get("code")))
            return True
        cb(_normalize_result(result), None)
        return True


def _normalize_result(result):
    """能力应答归一：{status, json} / 原始 body 两种形态都接受。"""
    if not isinstance(result, dict):
        return {"status": 0, "json": None, "text": str(result or "")}
    status = result.get("status") if result.get("status") is not None else result.get("status_code")
    body = result.get("json")
    if body is None and result.get("body") is not None:
        raw = result.get("body")
        if isinstance(raw, dict):
            body = raw
        else:
            try:
                body = json.loads(raw)
            except (TypeError, ValueError):
                body = None
    if isinstance(result.get("errcode"), int):
        body = result
    return {"status": int(status or 0), "json": body,
            "text": result.get("text") or result.get("body_text") or ""}


def _wechat_result_error(payload):
    """把微信应答转成 TransportError（errcode != 0）；成功返回 None。"""
    if not isinstance(payload, dict):
        return TransportError("protocol", "应答不是合法 JSON")
    code = payload.get("errcode")
    if code in (0, None):
        return None
    return TransportError("wechat", wechat_error_text(code, payload.get("errmsg") or ""), code=int(code))


