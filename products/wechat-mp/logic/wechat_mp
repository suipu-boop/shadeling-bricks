def _ensure_dir(path, mode=0o700):
    if not os.path.isdir(path):
        os.makedirs(path, mode=mode, exist_ok=True)
    return path


def _write_private(path, text):
    """原子写 + 0600（凭据只落私有目录，不写全局可读位置）。"""
    _ensure_dir(os.path.dirname(path))
    tmp = "%s.tmp-%s" % (path, uuid.uuid4().hex[:8])
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(text)
    finally:
        os.replace(tmp, path)
    try:
        os.chmod(path, 0o600)
    except OSError:
        pass
    return path


def _read_json(path):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return None


class Store:
    """凭据 / 令牌 / 导出物存储：private_dir 优先，旧版全局目录只读接管。"""

    def __init__(self, private_dir=None):
        self.private_dir = private_dir or LEGACY_DIR
        self.legacy_dir = LEGACY_DIR
        self.adopted_from_legacy = False

    @property
    def account_path(self):
        return os.path.join(self.private_dir, "account.json")

    @property
    def token_path(self):
        return os.path.join(self.private_dir, "token.json")

    @property
    def export_dir(self):
        return os.path.join(self.private_dir, "exports")

    def load_account(self):
        data = _read_json(self.account_path)
        if data:
            return {"app_id": str(data.get("app_id") or ""), "secret": str(data.get("secret") or "")}
        legacy = _read_json(os.path.join(self.legacy_dir, "account.json"))
        if legacy:
            self.adopted_from_legacy = True
            return {"app_id": str(legacy.get("app_id") or ""), "secret": str(legacy.get("secret") or "")}
        return {"app_id": "", "secret": ""}

    def save_account(self, app_id, secret):
        _write_private(self.account_path,
                       json.dumps({"app_id": app_id, "secret": secret,
                                   "saved_at": _now_text()}, ensure_ascii=False, indent=2))
        return self.account_path

    def load_token(self):
        data = _read_json(self.token_path) or {}
        return data if isinstance(data, dict) else {}

    def save_token(self, token, expires_at, app_id):
        _write_private(self.token_path, json.dumps(
            {"access_token": token, "expires_at": expires_at, "app_id": app_id,
             "saved_at": _now_text()}, ensure_ascii=False, indent=2))


def _now_text():
    return datetime.now().strftime("%Y-%m-%d %H:%M:%S")


