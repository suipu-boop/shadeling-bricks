def act_upload_asset(state, envelope):
    rt = state.setdefault("_rt", {})
    if not TRANSPORT.available:
        _notice(state, "上传未执行：%s" % TRANSPORT.why_unavailable(), True)
        return state

    def picked(ok, message, path):
        if not ok or not path:
            _notice(state, "上传取消：%s" % message, True)
            _push()
            return
        try:
            with open(path, "rb") as handle:
                data = handle.read()
        except OSError as exc:
            _notice(state, "读取本地文件失败：%s" % exc, True)
            _push()
            return
        if len(data) > MULTIPART_LIMIT_BYTES:
            _notice(state, "上传失败：单张图片不得超过 10MB（当前 %.1fMB）"
                    % (len(data) / 1048576.0), True)
            _push()
            return
        mime = "image/png" if path.lower().endswith(".png") else "image/jpeg"
        rt["busy"] = True
        _notice(state, "正在上传素材…")

        def after(payload, err):
            rt["busy"] = False
            if err:
                _notice(state, "上传失败：%s" % err.message, True)
                _push()
                return
            media_id = str(payload.get("media_id") or "")
            url = str(payload.get("url") or "")
            state.setdefault("assets", []).append({
                "file_name": os.path.basename(path),
                "media_id": media_id,
                "url": url,
                "uploaded_at": _now_text(),
            })
            _notice(state, "已上传到永久素材：%s" % (os.path.basename(path)))
            _log("material_add media_id_len=%d" % len(media_id))
            _push()

        _client().upload_material(path, data, mime, after)

    HOST.pick_file(["image"], picked)
    return state


