def _coerce(key, value):
    if key in ("show_cover_pic", "need_open_comment", "only_fans_can_comment"):
        if isinstance(value, str):
            return value.strip().lower() in ("1", "true", "yes", "on", "是")
        return bool(value)
    return value


def _absorb(envelope, state):
    """把表单交互态（宿主 ui_state / payload）并入 state；返回命中的字段名集合。"""
    hits = set()
    sources = []
    payload = envelope.get("payload") or {}
    ui_state = envelope.get("ui_state") or {}
    for src in (ui_state, payload):
        if isinstance(src, dict):
            sources.append(src)
            for nested in ("values", "fields", "form", "form_values"):
                if isinstance(src.get(nested), dict):
                    sources.append(src[nested])
    for src in sources:
        for raw_key in FORM_FIELD_KEYS:
            if raw_key not in src:
                continue
            value = _coerce(raw_key, src.get(raw_key))
            if value is None:
                continue
            key = FIELD_TO_STATE.get(raw_key, raw_key)
            state[key] = value
            hits.add(key)
    return hits


def _node_item(envelope, state, key="assets"):
    """卡片动作的条目定位：payload.item → payload.index → ui_state 选择 → node_id 序号。

    渲染器对列表行**行内事件**只补 `index`（不携带 item，见 NodeRenderer.listView），
    故 `payload.index` 是真实链路的主定位键；`#<n>` 后缀仅作兼容。
    """
    payload = envelope.get("payload") or {}
    item = payload.get("item") or payload.get("row") or payload.get("value")
    if isinstance(item, dict):
        return item
    rows = {
        "assets": state.get("assets") or [],
        "drafts": state.get("drafts") or [],
    }.get(key) or []
    try:
        row_index = int(payload.get("index"))
    except (TypeError, ValueError):
        row_index = None
    if row_index is not None and 0 <= row_index < len(rows):
        return rows[row_index]
    ui_state = envelope.get("ui_state") or {}
    selected = ui_state.get("selected_item") or ui_state.get("selection")
    if isinstance(selected, dict):
        return selected
    node_id = str(envelope.get("node_id") or "")
    m = re.search(r"[#:](\d+)$", node_id)
    if m:
        idx = int(m.group(1))
        if 0 <= idx < len(rows):
            return rows[idx]
    for candidate in (payload.get("media_id"), payload.get("id")):
        if candidate:
            for row in rows:
                if row.get("media_id") == candidate:
                    return row
    return None


