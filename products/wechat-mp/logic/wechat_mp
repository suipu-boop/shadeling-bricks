            _text("account_store_path", "存储位置：{{state.store_path}}", "caption", 2),
            _text("media_count", "共 {{state.assets_count}} 个素材", "caption"),
            _text("drafts_count", "共 {{state.drafts_count}} 条草稿", "caption"),
        ],
    }


def build_root(state):
    """按 state 产出 UI root：包内骨架（ui/main.json）+ 数据面（纯函数，不做 IO）。"""
    _sync_derived(state)
    if not isinstance(UI_BASE, dict):
        return _fallback_root(state)
    return copy.deepcopy(UI_BASE)


def render(state):
    """SDK render 钩子：宿主每帧取 root（状态派生在此收敛）。"""
    return build_root(state)


