        rt["publish_state"] = "unknown"
        rt["publish_reason"] = TRANSPORT.why_unavailable()
        _notice(state, "无法探测发布权限：%s" % TRANSPORT.why_unavailable(), True)
        return state
    rt["publish_state"] = "probing"
    _notice(state, "正在探测 freepublish 权限…")

    def after(payload, err):
        if err:
            if err.code in NO_PERMISSION_CODES:
                rt["publish_state"] = "denied"
                rt["publish_reason"] = ("发布能力不可用：%s；已按契约隐藏发布入口，仅保留草稿箱。"
                                        % err.message)
            else:
                rt["publish_state"] = "unknown"
                rt["publish_reason"] = "探测失败：%s" % err.message
            _notice(state, rt["publish_reason"], err.code not in NO_PERMISSION_CODES)
        else:
            rt["publish_state"] = "granted"
            rt["publish_reason"] = "freepublish/submit 权限可用，可提交发布。"
            _notice(state, "发布能力可用（freepublish）")
