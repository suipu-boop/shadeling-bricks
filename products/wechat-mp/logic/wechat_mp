def on_capability_result(call_id, result, error):
    if TRANSPORT.resolve(call_id, result, error):
        return
    job = CALL_JOBS.pop(call_id, None)
    if job is None:
        return
    kind = job[0] if isinstance(job, tuple) else None
    if kind == "clipboard":
        cb = job[1]
        cb(not error, "复制成功" if not error else "复制失败：%s" % (error or {}).get("message", ""))
    elif kind == "pick":
        cb = job[1]
        path = ""
        if not error and isinstance(result, dict):
            files = result.get("files") or result.get("paths") or []
            if isinstance(files, list) and files:
                first = files[0]
                path = first.get("path") if isinstance(first, dict) else str(first)
            path = path or result.get("path") or ""
        if error:
            cb(False, str((error or {}).get("message") or "文件选择失败"), None)
        elif not path:
            cb(False, "未选择文件", None)
        else:
            cb(True, "已选择 %s" % path, path)
    _push()


