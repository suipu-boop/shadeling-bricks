def act_save_draft(state, envelope):
    _absorb(envelope, state)
    app_id = str(state.get("app_id") or "").strip()
    if not app_id or not state.get("secret"):
        _notice(state, "保存草稿失败：请先在「账号」页保存凭据", True)
        return state
    if not TRANSPORT.available:
        _notice(state, "保存草稿未执行：%s" % TRANSPORT.why_unavailable(), True)
        return state
    missing = []
    if not str(state.get("payload_title") or "").strip():
        missing.append("标题")
    cover = str(state.get("cover_media_id") or (state.get("_rt") or {}).get("cover_id") or "").strip()
    if not cover:
        missing.append("封面素材（先在「素材」页上传并「设为封面」）")
    if not (state.get("markdown_source") or "").strip():
        missing.append("正文")
    if missing:
        _notice(state, "保存草稿失败，还缺：%s" % " / ".join(missing), True)
        return state
    rt = state.setdefault("_rt", {})
    rt["busy"] = True
    _notice(state, "正在保存草稿…")
    article = build_article(state, cover)
    _log("draft_add body_keys=%s bytes=%d" % (",".join(sorted(article.keys())),
                                              len(json.dumps(article, ensure_ascii=False).encode("utf-8"))))

    def after(payload, err):
        rt["busy"] = False
        if err:
            _notice(state, "保存草稿失败：%s" % err.message, True)
            _push()
            return
        media_id = str(payload.get("media_id") or "")
        _notice(state, "已保存到草稿箱（media_id %s）" % (media_id or "未返回"))
        _push()
        _refresh_drafts_inner(state, act_after=True)

    _client().draft_add([article], after)
    return state


def build_article(state, cover_media_id):
    """微信草稿 article 结构（字段口径对齐 v1 DraftPayload.jsonObject）。"""
    return {
        "title": str(state.get("payload_title") or "").strip(),
        "author": str(state.get("payload_author") or "").strip(),
        "digest": str(state.get("payload_digest") or "").strip(),
        "content": (state.get("_rt") or {}).get("html") or "",
        "content_source_url": str(state.get("content_source_url") or "").strip(),
        "thumb_media_id": cover_media_id,
        "show_cover_pic": 1 if state.get("show_cover_pic", True) else 0,
        "need_open_comment": 1 if state.get("need_open_comment") else 0,
        "only_fans_can_comment": 1 if state.get("only_fans_can_comment") else 0,
    }


def act_refresh_drafts(state, envelope):
    return _refresh_drafts_inner(state, act_after=False)


def _refresh_drafts_inner(state, act_after):
    rt = state.setdefault("_rt", {})
    if not TRANSPORT.available:
        _notice(state, "刷新草稿未执行：%s" % TRANSPORT.why_unavailable(), True)
        return state
    rt["drafts_refreshing"] = True
    _notice(state, "正在刷新草稿列表…")

    def after(payload, err):
        rt["drafts_refreshing"] = False
        if err:
            _notice(state, "刷新草稿失败：%s" % err.message, True)
            _push()
            return
        items = payload.get("item") or []
        rows = []
        for item in items[:20]:
            content = item.get("content") or {}
            news = (content.get("news_item") or [{}])[0]
            rows.append({
                "media_id": str(item.get("media_id") or ""),
                "title": str(news.get("title") or "未命名"),
                "digest": str(news.get("digest") or ""),
                "updated_at": _fmt_ts(item.get("update_time")),
                "url": str(news.get("url") or ""),
            })
        state["drafts"] = rows
        total = payload.get("total_count")
        _notice(state, "草稿列表已刷新：%d 条%s" % (len(rows),
                  "（共 %s 条）" % total if total is not None else ""))
        _log("draft_batchget → %d 条" % len(rows))
        _push()

    _client().draft_batchget(0, 20, after)
    return state


def _fmt_ts(value):
