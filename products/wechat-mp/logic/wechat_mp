def _fallback_root(state):
    """包内 UI 声明不可用时的最小骨架（显式提示，不静默降级）。"""
    return {
        "type": "container",
        "id": "root",
        "props": {"direction": "vertical", "gap": 14, "padding": PADDING},
        "children": [
            _text("app_title", "微信公众号", "title"),
