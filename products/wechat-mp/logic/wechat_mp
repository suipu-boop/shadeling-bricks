class HostAdapter:
    """把 host 能力收敛到三个入口，便于自测替换（FakeHost）。"""

    def granted(self, permission):
        return permission in (getattr(APP, "granted_permissions", None) or [])

    def copy_text(self, text, on_done=None):
        if not self.granted("ui.clipboard.write"):
            if on_done:
                on_done(False, "剪贴板能力 ui.clipboard.write 未授予")
            return
        call_id = APP.call_capability("ui.clipboard.write", {"text": text})
        if call_id and on_done:
            CALL_JOBS[call_id] = ("clipboard", on_done)

    def pick_file(self, kinds, on_done):
        if not self.granted("fs.pick"):
            on_done(False, "文件选择能力 fs.pick 未授予", None)
            return
        call_id = APP.call_capability("fs.pick", {"kinds": kinds, "multiple": False})
        if call_id:
            CALL_JOBS[call_id] = ("pick", on_done)
        else:
            on_done(False, "能力调用未返回 call_id", None)

    def toast(self, text):
        APP.overlay("toast", text=text)


