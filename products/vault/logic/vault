@APP.action("manual_change", node_id="manual_form", event="change")
def _on_manual_change(state, event):
    """表单 change：只记录草稿并重渲染（D2 可切换为纯 state 帧降级）。"""
    payload = event.get("payload") or {}
    field = payload.get("field") or payload.get("field_id")
    if not field and isinstance(payload, dict):
        spec_ids = {spec["id"] for spec in manual_specs(state.get("manual_kind") or MANUAL_KINDS[0])}
        for key in payload:
            if key in spec_ids:
                field = key
                break
    if field:
        state.setdefault("manual_draft", {})[str(field)] = payload.get("value", "")
    APP.log("info", "manual change %s" % field)
    return state


@APP.action("manual_submit", node_id="manual_form", event="submit")
def _on_manual_submit(state, event):
    payload = event.get("payload") or {}
    specs = manual_specs(state.get("manual_kind") or MANUAL_KINDS[0])
    spec_ids = {spec["id"] for spec in specs}
    draft = dict(state.get("manual_draft") or {})
    if isinstance(payload, dict):
        if str(payload.get("field_id") or "") in spec_ids:  # 单字段提交形态
            draft[str(payload.get("field_id"))] = payload.get("value", "")
        else:
            for key, value in payload.items():
                if key in spec_ids:
                    draft[str(key)] = value
    state["manual_draft"] = draft
    return save_manual(state, draft)


