@APP.action("confirm_delete", node_id="btn_confirm_delete")
def _on_confirm_delete(state, event):
    """删除第二步：用户已确认 → 移除条目与私有文件。"""
    aid = state.get("detail_id") or ""
    ok = STORE.delete(aid) if aid else False
    state["confirm_delete"] = False
    state["detail_open"] = False
    if not ok:
        _banner(state, "删除失败：条目不存在（%s）" % aid, "warn")
        return state
    reload_items(state)
    _banner(state, "已删除该条目", "info")
    state["last_action"] = "已删除 %s" % aid
    APP.log("info", "deleted id=%s，剩余 %d 条" % (aid, STORE.count()))
    return state


