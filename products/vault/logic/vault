MANUAL_KINDS = (
    ["document:%s" % t for t in DOCUMENT_TYPE_OPTIONS] + ["account", "webpage", "note"]
)


def manual_specs(kind):
    """按录入类型返回字段定义（id / label / sensitive / placeholder）。"""
    if kind.startswith("document:"):
        doc_type = kind.split(":", 1)[1]
        return [
            {"id": "doc_type", "label": "证件类型", "value": doc_type},
            {"id": "issuer", "label": "签发方", "placeholder": "如 XX 市公安局 / XX 公司"},
            {"id": "number_full", "label": "证件号码", "sensitive": True, "placeholder": "号码加密存储"},
            {"id": "valid_from", "label": "生效日期", "placeholder": "YYYY-MM-DD"},
            {"id": "valid_to", "label": "到期日期", "placeholder": "YYYY-MM-DD"},
            {"id": "description", "label": "备注", "placeholder": "可选"},
        ]
    if kind == "account":
        return [
            {"id": "account_name", "label": "账户名", "placeholder": "账号 / 用户名"},
            {"id": "password", "label": "口令", "sensitive": True, "placeholder": "加密存储"},
            {"id": "url", "label": "网址", "placeholder": "登录地址，可选"},
            {"id": "description", "label": "备注", "placeholder": "可选"},
        ]
    if kind == "webpage":
        return [
            {"id": "url", "label": "网址", "placeholder": "https://…"},
            {"id": "description", "label": "备注", "placeholder": "可选"},
        ]
    return [{"id": "text", "label": "内容"}]


def manual_kind_type(kind):
    if kind.startswith("document:"):
        return "document"
    if kind == "account":
        return "note"       # 与 Swift ManualKind.account.type 对齐
    if kind == "webpage":
        return "webpage"
    return "note"


def manual_kind_label(kind):
    if kind.startswith("document:"):
        return "证件 · %s" % kind.split(":", 1)[1]
    return {"account": "账号", "webpage": "收藏", "note": "笔记"}.get(kind, kind)


