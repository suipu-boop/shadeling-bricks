def resolve_vault_dir():
    """库位置推导（与 Swift ``VaultPaths.vaultDir`` 一致）。"""
    home_env = os.environ.get("SHADELING_HOME")
    if home_env:
        return os.path.join(home_env, "vault")
    app_support = os.path.join(os.path.expanduser("~/Library/Application Support"),
                               "Shadeling", "vault")
    if os.path.isdir(app_support):
        return app_support
    return os.path.join(os.path.expanduser("~"), ".shadeling", "vault")


def _openssl_bin():
    return shutil.which("openssl") or "/usr/bin/openssl"


def _security_bin():
    return "/usr/bin/security" if os.path.exists("/usr/bin/security") else (shutil.which("security") or "")


def _run(args, stdin_text=None):
    try:
        return subprocess.run(args, input=stdin_text, capture_output=True, text=True)
    except OSError as exc:
        sys.stderr.write("[vault] 子进程执行失败 %s：%s\n" % (args[0], exc))
        return None


def keychain_get():
    sec = _security_bin()
    if not sec:
        return ""
    proc = _run([sec, "find-generic-password", "-s", KEYCHAIN_SERVICE,
                 "-a", KEYCHAIN_ACCOUNT, "-w"])
    if proc is None or proc.returncode != 0:
        return ""
    return (proc.stdout or "").strip()


def keychain_set(key):
    sec = _security_bin()
    if not sec:
        return False
    proc = _run([sec, "add-generic-password", "-s", KEYCHAIN_SERVICE,
                 "-a", KEYCHAIN_ACCOUNT, "-w", key, "-U"])
    return bool(proc is not None and proc.returncode == 0)


def gen_key():
    proc = _run([_openssl_bin(), "rand", "-hex", "32"])
    key = (proc.stdout or "").strip() if proc is not None else ""
    if len(key) != 64:
        raise RuntimeError("openssl rand -hex 32 生成密钥失败")
    return key


def load_key(vault_dir):
    """密钥：显式注入 → 钥匙串 → keyfile（0600）→ 生成并落钥匙串 + keyfile。"""
    injected = (os.environ.get("SHADELING_VAULT_KEY") or "").strip()
    if injected:
        return injected
    from_keychain = keychain_get()
    if from_keychain:
        return from_keychain
    keyfile = os.path.join(vault_dir, ".vault_key")
    if os.path.isfile(keyfile):
        try:
            with open(keyfile, "r", encoding="utf-8") as handle:
                existing = handle.read().strip()
            if existing:
                return existing
        except OSError:
            pass
    key = gen_key()
    keychain_set(key)
    try:
        os.makedirs(vault_dir, exist_ok=True)
        with open(keyfile, "w", encoding="utf-8") as handle:
            handle.write(key)
        os.chmod(keyfile, 0o600)
    except OSError:
        pass
    return key


def encrypt_text(plain, key):
    """与蓝本逐参一致：openssl enc -aes-256-cbc -salt -pbkdf2 -pass pass:<key> -base64。"""
    proc = _run([_openssl_bin(), "enc", "-aes-256-cbc", "-salt", "-pbkdf2",
                 "-pass", "pass:%s" % key, "-base64"], stdin_text=plain)
    if proc is None or proc.returncode != 0:
        raise RuntimeError("加密失败（openssl）：%s" % (proc.stderr if proc else "无法启动"))
    blob = (proc.stdout or "").strip()
    if not blob:
        raise RuntimeError("加密失败：openssl 无输出")
    return blob


def decrypt_text(blob, key):
    proc = _run([_openssl_bin(), "enc", "-d", "-aes-256-cbc", "-pbkdf2",
                 "-pass", "pass:%s" % key, "-base64"], stdin_text=blob)
    if proc is None or proc.returncode != 0:
        raise RuntimeError("解密失败（openssl）：%s" % (proc.stderr if proc else "无法启动"))
    return proc.stdout or ""


def mask_number(value):
    """证件号脱敏：前 4 后 4 保留（与蓝本 _mask / Swift maskNumber 同规）。"""
    text = str(value).strip()
    if len(text) <= 8:
        return text[:1] + "*" * max(0, len(text) - 1)
    return text[:4] + "*" * (len(text) - 8) + text[-4:]


def mask_sensitive_text(text):
    """整段文本脱敏：把长度 ≥ 6 的连续数字（证件号 / 卡号等）按 mask_number 规则遮挡。

    用于「识别原文」下发 UI 树与落库前的处理；原始文本仍以密文留存（见 save_ocr），
    保证列表 / 卡片 / 弹层与 SQLite 内均不出现明文号码（§7.5 验收 2 的脱敏口径）。
    """
    return re.sub(r"\d{6,}", lambda match: mask_number(match.group(0)), str(text))


def fmt_ts(ts):
    try:
        return time.strftime("%Y-%m-%d %H:%M", time.localtime(float(ts)))
    except (TypeError, ValueError):
        return ""


def rel_time(ts):
    try:
        delta = time.time() - float(ts)
    except (TypeError, ValueError):
        return ""
    if delta < 60:
        return "刚刚"
    if delta < 3600:
        return "%d 分钟前" % int(delta // 60)
    if delta < 86400:
        return "%d 小时前" % int(delta // 3600)
    if delta < 86400 * 30:
        return "%d 天前" % int(delta // 86400)
    return fmt_ts(ts)[:10]


_IMPORT_STRIP = re.compile(r"(?is)<(script|style|head|nav|footer)[^>]*>.*?</\1>")
_TAG_STRIP = re.compile(r"<[^>]+>")

DOC_NUMBER_RE = re.compile(r"[0-9]{17}[0-9Xx]")
DATE_RE = re.compile(r"(\d{4})[.\-/年](\d{1,2})[.\-/月](\d{1,2})")
DOC_TYPE_RULES = [
    (["居民身份证", "身份证"], "身份证"),
    (["护照"], "护照"),
    (["驾驶证", "驾照"], "驾驶证"),
    (["往来港澳"], "往来港澳通行证"),
    (["台湾居民来往大陆通行证", "台胞证"], "台湾居民来往大陆通行证"),
    (["资格证", "执业证", "从业资格"], "资格证"),
]


def parse_document_fields(text):
    """从 OCR/文本中尽力抽取证件字段（与 Swift VaultOCR.parseDocumentFields 同步）。"""
    out = {}
    for keys, value in DOC_TYPE_RULES:
        if any(k in text for k in keys):
            out["doc_type"] = value
            break
    dates = []
    for match in DATE_RE.finditer(text):
        try:
            dates.append("%04d-%02d-%02d" % (int(match.group(1)), int(match.group(2)), int(match.group(3))))
        except ValueError:
            continue
    if len(dates) >= 2:
        out["valid_from"], out["valid_to"] = dates[0], dates[1]
    elif len(dates) == 1:
        out["valid_to"] = dates[0]
    number = DOC_NUMBER_RE.search(text)
    if number:
        out["number_full"] = number.group(0)
    return out


class VaultStore:
    """vault 数据层（逻辑进程内自持；与蓝本同库文件、同 schema、同加密口径）。"""

    def __init__(self, root=None):
        self.root = root or resolve_vault_dir()
        os.makedirs(self.root, exist_ok=True)
        self.db_path = os.path.join(self.root, "vault.db")
        self._conn = sqlite3.connect(self.db_path)
        self._conn.executescript(_SCHEMA)
        self._conn.commit()
        self._key = None

    # ---- 密钥 / 加解密 ----
    def key(self):
        if self._key is None:
            self._key = load_key(self.root)
        return self._key

    def encrypt(self, plain):
        return encrypt_text(plain, self.key())

    def decrypt(self, blob):
        return decrypt_text(blob, self.key())

    # ---- 行 → 字典（脱敏；与蓝本 _row_to_dict 字段口径一致）----
    def _row_to_asset(self, row, include_sensitive=False):
        aid, typ, title, created, updated, payload = row
        try:
            parsed = json.loads(payload)
        except ValueError:
            parsed = {}
        fields = dict(parsed.get("fields") or {})
        enc = dict(parsed.get("enc") or {})
        top_source = parsed.get("source")
        ai = parsed.get("ai") or {}
        asset = {
            "id": aid, "type": typ, "title": title,
            "created_at": created, "updated_at": updated,
            "file_ref": parsed.get("file_ref"),
            "has_sensitive": bool(enc),
            "ai_summary": ai.get("summary", ""),
            "ai_tags": list(ai.get("ai_tags") or []),
            "ai_key_points": list(ai.get("key_points") or []),
        }
        asset.update(fields)
        if top_source:
            asset["source"] = top_source
        asset["is_ai"] = (top_source == "ai")
        if include_sensitive and enc:
            for name, blob in enc.items():
                try:
                    asset[name] = self.decrypt(blob)
                except Exception:
                    asset[name] = "***解密失败***"
        return asset

    _SELECT = "SELECT id,type,title,created_at,updated_at,payload FROM assets"

    # ---- 查列表（卡片墙用；AI 口径在 Python 侧判定，避免 JSON 序列化差异）----
    def list(self, type=None, q=None, ai_only=False, top_k=LIST_LIMIT + 1):
        sql = self._SELECT
        wheres, args = [], []
        if type:
            wheres.append("type=?")
            args.append(type)
        if q:
            wheres.append("(title LIKE ? OR payload LIKE ?)")
            args += ["%%%s%%" % q, "%%%s%%" % q]
        if wheres:
            sql += " WHERE " + " AND ".join(wheres)
        sql += " ORDER BY updated_at DESC, id DESC LIMIT ?"
        args.append(top_k)
        rows = self._conn.execute(sql, args).fetchall()
        assets = [self._row_to_asset(row) for row in rows]
        if ai_only:
            assets = [a for a in assets if a.get("is_ai")]
        return assets

    def get(self, aid, include_sensitive=False):
        row = self._conn.execute(self._SELECT + " WHERE id=?", (aid,)).fetchone()
        if not row:
            return None
        return self._row_to_asset(row, include_sensitive=include_sensitive)

    def plain_fields(self, aid):
        """详情解锁：返回该资产 enc 段全部明文（无 enc 返回空字典）。"""
        row = self._conn.execute("SELECT payload FROM assets WHERE id=?", (aid,)).fetchone()
        if not row:
            return {}
        try:
            parsed = json.loads(row[0])
        except ValueError:
            return {}
        enc = dict(parsed.get("enc") or {})
        out = {}
        for name, blob in enc.items():
            try:
                out[name] = self.decrypt(blob)
            except Exception:
                out[name] = "***解密失败***"
        return out

    # ---- 增 ----
    def add(self, params):
        typ = params.get("type")
        if typ not in ASSET_TYPES:
            raise ValueError("未知资产类型：%s" % typ)
        fields = dict(params.get("fields") or {})
        sensitive = dict(params.get("sensitive") or {})
        source = params.get("source")
        now = time.time()
        aid = uuid.uuid4().hex[:12]
        enc = {}

        # 文件落盘（私有目录 vault/<id>/，与蓝本一致）
        file_ref = None
        src_path = params.get("file_path")
        if src_path and os.path.isfile(src_path):
            target_dir = os.path.join(self.root, aid)
            os.makedirs(target_dir, exist_ok=True)
            dest = os.path.join(target_dir, os.path.basename(src_path))
            shutil.copyfile(src_path, dest)
            file_ref = dest

        # document.number_full 加密 + 脱敏
        if typ == "document":
            num = fields.pop("number_full", None) or sensitive.pop("number_full", None)
            if num:
                enc["number_full"] = self.encrypt(str(num))
                fields["number_masked"] = mask_number(num)

        for name, value in sensitive.items():
            if value:
                enc[name] = self.encrypt(str(value))

        # 网页资产：默认不做网络抓取（本地优先）；仅显式开启时抓标题/摘要
        if typ == "webpage" and not fields.get("excerpt") and fields.get("url"):
            if os.environ.get("SHADELING_VAULT_ALLOW_FETCH") == "1":
                fetched = self.fetch_webpage(fields["url"])
                if "error" not in fetched:
                    fields.setdefault("title", fetched["title"])
                    fields["excerpt"] = fetched["excerpt"]
                    fields.setdefault("source", fetched.get("source", ""))

        title = (params.get("title") or "").strip() or default_title(typ, fields)
        payload = {"fields": fields, "enc": enc, "file_ref": file_ref}
        if source:
            payload["source"] = source
        self._conn.execute(
            "INSERT INTO assets (id,type,title,created_at,updated_at,payload) VALUES (?,?,?,?,?,?)",
            (aid, typ, title, now, now, json.dumps(payload, ensure_ascii=False)))
        self._conn.commit()
        return self._row_to_asset((aid, typ, title, now, now, json.dumps(payload, ensure_ascii=False)))

    # ---- 改（OCR 文本等附加字段写回，不触碰 enc / file_ref / ai）----
    def update_fields(self, aid, fields):
        row = self._conn.execute("SELECT payload FROM assets WHERE id=?", (aid,)).fetchone()
        if not row:
            return False
        try:
            parsed = json.loads(row[0])
        except ValueError:
            return False
        merged = dict(parsed.get("fields") or {})
        merged.update(fields)
        parsed["fields"] = merged
        self._conn.execute("UPDATE assets SET payload=?, updated_at=? WHERE id=?",
                           (json.dumps(parsed, ensure_ascii=False), time.time(), aid))
        self._conn.commit()
        return True

    # ---- 删 ----
    def delete(self, aid):
        row = self._conn.execute("SELECT id FROM assets WHERE id=?", (aid,)).fetchone()
        if not row:
            return False
        asset_dir = os.path.join(self.root, aid)
        if os.path.isdir(asset_dir):
            shutil.rmtree(asset_dir, ignore_errors=True)
        self._conn.execute("DELETE FROM assets WHERE id=?", (aid,))
        self._conn.commit()
        return True

    def count(self):
        return int(self._conn.execute("SELECT COUNT(*) FROM assets").fetchone()[0])

    # ---- 网页抓取（可选，默认不启用；与蓝本同口径）----
    def fetch_webpage(self, url, timeout=12.0):
        import urllib.error
        import urllib.parse
        import urllib.request
        try:
            req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 ShadelingVault"})
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                raw = resp.read()
                charset = resp.headers.get_content_charset() or "utf-8"
            html = raw.decode(charset, errors="replace")
        except (urllib.error.URLError, OSError, TimeoutError) as exc:
            return {"error": "抓取失败：%s: %s" % (type(exc).__name__, exc)}
        title_match = re.search(r"<title[^>]*>(.*?)</title>", html, re.S | re.I)
        title = re.sub(r"\s+", " ", _TAG_STRIP.sub(" ", title_match.group(1))).strip() if title_match else url
        body = _IMPORT_STRIP.sub(" ", html)
        text = re.sub(r"\s+", " ", _TAG_STRIP.sub(" ", body)).strip()
        try:
            host = urllib.parse.urlparse(url).netloc
        except ValueError:
            host = ""
        return {"title": title[:120], "excerpt": text[:600], "source": host}


def default_title(typ, fields):
    if typ == "document":
        return fields.get("doc_type") or "证件"
    if typ == "webpage":
        return fields.get("title") or fields.get("url") or "收藏"
    if typ == "note":
        text = fields.get("text") or ""
        if text:
            return text[:24]
        return fields.get("account_name") or "笔记"
    if typ == "image":
        return "图片"
    return "资产"


