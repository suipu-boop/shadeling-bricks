    if not aid:
        _banner(state, "请先打开一条资产再解锁", "warn")
        return state
    if not _require_permission(state, "auth.biometric", "查看敏感字段"):
        state["detail_unlocking"] = False
        state["detail_auth_error"] = ("未授予「auth.biometric」权限，无法解锁；"
                                      "请在系统设置中授权后重试（错误码 %d）"
                                      % brick_sdk.ERR_CAPABILITY_DENIED)
        state["last_action"] = "敏感字段解锁被拒（权限未授予）"
        return state
    state["detail_unlocking"] = True
    state["detail_auth_error"] = ""
    call = APP.call_capability("auth.biometric",
                               {"reason": "解锁 Vault 敏感字段", "asset_id": aid})
    CALL_JOBS[call] = ("auth.biometric", aid)
    APP.log("info", "capability auth.biometric 已发起 id=%s" % call)
    return state


