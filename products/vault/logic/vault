def _startup_checks():
    """启动自检：预载条目 + 权限口径落 stderr（不阻塞启动、不静默、握手前不占用 stdout）。"""
    fresh = dict(INITIAL_STATE)
    reload_items(fresh)
    APP.state.update(fresh)
    _stderr("[vault] 预载完成：vault_dir=%s，现有 %d 条；调用未授予的权限时将回 4309 并明确提示"
            % (STORE.root, STORE.count()))


def _stderr(text):
    try:
        sys.stderr.write(text.rstrip("\n") + "\n")
        sys.stderr.flush()
    except (BrokenPipeError, OSError, ValueError):
        pass


if __name__ == "__main__":
    sys.stderr.write("[vault] start pid=%d vault_dir=%s sdk=%s\n"
                     % (os.getpid(), STORE.root, _SDK_DIR))
    sys.stderr.flush()
    _startup_checks()
    raise SystemExit(brick_sdk.serve(APP))
