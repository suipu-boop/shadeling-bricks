def grid_columns_for(width):
    """由 viewport 宽度算自适应列数（min 1，max 6；640pt 最小宽度下 ≥ 2）。"""
    try:
        width = float(width)
    except (TypeError, ValueError):
        width = MIN_VIEWPORT_WIDTH
    if width < GRID_MIN_W:
        width = MIN_VIEWPORT_WIDTH
    usable = width - 2 * PADDING
    count = int((usable + GRID_GAP_LOCAL) // (GRID_MIN_W + GRID_GAP_LOCAL))
    return max(1, min(GRID_MAX_COLUMNS, count))


def card_of(asset):
    return {
        "id": asset["id"],
        "type": asset["type"],
        "title": asset["title"],
        "type_label": TYPE_LABELS.get(asset["type"], asset["type"]),
        "subtitle": subtitle_of(asset),
        "is_ai": bool(asset.get("is_ai")),
        "has_sensitive": bool(asset.get("has_sensitive")),
        "updated_rel": rel_time(asset.get("updated_at")),
    }


def subtitle_of(asset):
    """卡片副标题（与 Swift VaultAsset.subtitle 同规）。"""
    typ = asset.get("type")
    if typ == "document":
        parts = [asset.get("doc_type"), ("至 %s" % asset["valid_to"]) if asset.get("valid_to") else ""]
    elif typ == "webpage":
        parts = [asset.get("source"), asset.get("url")]
    elif typ == "skill_snapshot":
        parts = [asset.get("category"), asset.get("version")]
    elif typ == "image":
        parts = [("相册 · %s" % asset["album"]) if asset.get("album") else ""]
    elif typ == "note":
        text = asset.get("text") or ""
        parts = [text[:60]]
    else:
        parts = []
    return " · ".join([str(p) for p in parts if p])


def detail_rows_of(asset):
    """详情「基本信息」行（与 Swift DetailSheet.fields 同规）。"""
    typ = asset.get("type")
    rows = []
    if typ == "document":
        rows += [("证件类型", asset.get("doc_type") or ""), ("签发方", asset.get("issuer") or ""),
                 ("生效日期", asset.get("valid_from") or ""), ("到期日期", asset.get("valid_to") or ""),
                 ("编号(掩码)", asset.get("number_masked") or "")]
    elif typ == "webpage":
        if asset.get("url"):
            rows.append(("网址", asset["url"]))
        if asset.get("source") and not asset.get("is_ai"):
            rows.append(("来源", asset["source"]))
        if asset.get("excerpt"):
            rows.append(("摘要", asset["excerpt"]))
    elif typ == "skill_snapshot":
        rows += [("类别", asset.get("category") or ""), ("版本", asset.get("version") or ""),
                 ("说明", asset.get("skill_desc") or "")]
    elif typ == "note":
        if asset.get("account_name"):
            rows.append(("账户", asset["account_name"]))
        if asset.get("url"):
            rows.append(("网址", asset["url"]))
        if asset.get("text"):
            rows.append(("内容", asset["text"]))
    if asset.get("description"):
        rows.append(("备注", asset["description"]))
    tags = asset.get("tags") or []
    if tags:
        rows.append(("标签", "、".join(tags)))
    return [{"label": k, "value": v} for k, v in rows if v]


def _text(node_id, value, style=None, lines=None):
    props = {"value": value}
    if style:
        props["style"] = style
    if lines:
        props["lines"] = lines
    return {"type": "text", "id": node_id, "props": props}


def _button(node_id, label, action, style=None):
    node = {"type": "button", "id": node_id, "props": {"label": label}, "on": {"tap": action}}
    if style:
        node["props"]["style"] = style
    return node


