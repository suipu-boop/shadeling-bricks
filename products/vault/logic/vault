STORE = VaultStore()
CALL_JOBS = {}          # capability call_id -> (method, context)
BANNER_LEVELS = ("info", "warn")


def _banner(state, text, level="info"):
    state["banner"] = text
    state["banner_level"] = level if level in BANNER_LEVELS else "info"


def reload_items(state):
    """按「筛选 + 检索」重算卡片墙数据（AI 沉淀口径与 Swift filteredItems 一致）。"""
    flt = state.get("filter") or "all"
    query = (state.get("q") or "").strip()
    asset_type = None if flt in ("all", "ai") else flt
    assets = STORE.list(type=asset_type, q=query or None, ai_only=(flt == "ai"),
                        top_k=LIST_LIMIT + 1)
    state["truncated"] = len(assets) > LIST_LIMIT
    assets = assets[:LIST_LIMIT]
    state["items"] = [card_of(a) for a in assets]
    state["total"] = len(state["items"])
    state["filter_label"] = FILTER_LABELS.get(flt, flt)
    return state


def _permission_state(perm):
    """返回 True（已授予）/ False（明确未授予）/ None（底座未提供权限信息，交由底座裁决）。"""
    granted = list(APP.granted_permissions or [])
    declared = list(APP.declared_permissions or [])
    if perm in granted:
        return True
    if not granted and not declared:
        return None
    return False


def _require_permission(state, perm, action_label):
    """能力调用前的权限自查：未授予 → 明确提示（不静默失败，§7.5 验收 2）。"""
    verdict = _permission_state(perm)
    if verdict is True or verdict is None:
        return True
    message = ("未授予「%s」权限，%s不可用（错误码 %d）；请在系统设置中授权后重试"
               % (perm, action_label, brick_sdk.ERR_CAPABILITY_DENIED))
    _banner(state, message, "warn")
    state["last_action"] = "权限不足：%s" % perm
    APP.log("warn", message)
    return False


def _error_text(error, fallback):
    if not error:
        return fallback
    code = error.get("code")
    message = error.get("message") or fallback
    if code == brick_sdk.ERR_CAPABILITY_DENIED:
        return "未授予权限（%d）：%s；请在系统设置中授权后重试" % (code, message)
    return "%s（错误码 %s）" % (message, code)


def _payload_id(payload, state):
    """兼容三种渲染器回传约定：{id} / {item_id} / {item:{id}} / {index}。"""
    if not isinstance(payload, dict):
        return ""
    for key in ("id", "item_id", "asset_id"):
        if payload.get(key):
            return str(payload[key])
    item = payload.get("item")
    if isinstance(item, dict) and item.get("id"):
        return str(item["id"])
    index = payload.get("index")
    items = state.get("items") or []
    if isinstance(index, int) and 0 <= index < len(items):
        return items[index]["id"]
    return ""


def open_detail(state, aid):
    asset = STORE.get(aid, include_sensitive=False)
    if not asset:
        _banner(state, "未找到该资产：%s" % aid, "warn")
        return state
    channel = "AI 沉淀" if asset.get("is_ai") else "手动录入"
    state.update({
        "detail_open": True,
        "detail_id": aid,
        "detail_title": asset.get("title", ""),
        "detail_meta": "%s · %s · 更新于 %s" % (TYPE_LABELS.get(asset.get("type"), asset.get("type")),
                                                channel, fmt_ts(asset.get("updated_at"))),
        "detail_rows": detail_rows_of(asset),
        "detail_has_sensitive": bool(asset.get("has_sensitive")),
        "detail_unlocked": False,
        "detail_sensitive": {},
        "detail_unlocking": False,
        "detail_auth_error": "",
        "detail_ai_summary": asset.get("ai_summary") or "",
        "detail_ai_tags": asset.get("ai_tags") or [],
        "confirm_delete": False,
    })
    state["last_action"] = "打开详情：%s" % asset.get("title", "")
    APP.log("info", "open_detail id=%s has_sensitive=%s" % (aid, asset.get("has_sensitive")))
    return state


def open_manual(state, kind="document:身份证"):
    state["manual_open"] = True
    state["manual_kind"] = kind
    state["manual_error"] = ""
    state["manual_draft"] = {spec["id"]: spec.get("value", "") for spec in manual_specs(kind)}
    state["last_action"] = "打开手动新增（%s）" % manual_kind_label(kind)
    return state


def save_manual(state, draft):
    kind = state.get("manual_kind") or "document:身份证"
    asset_type = manual_kind_type(kind)
    fields, sensitive = {}, {}
    for spec in manual_specs(kind):
        value = str(draft.get(spec["id"], "") or "").strip()
        if not value:
            continue
        if spec.get("sensitive"):
            sensitive[spec["id"]] = value
        else:
            fields[spec["id"]] = value
    if asset_type == "document" and not fields.get("doc_type"):
        fields["doc_type"] = kind.split(":", 1)[1] if kind.startswith("document:") else "其他证件"
    try:
        asset = STORE.add({"type": asset_type, "fields": fields, "sensitive": sensitive})
    except Exception as exc:  # 加密/落盘失败 → 明确回显，不静默吞掉
        state["manual_error"] = "存入失败：%s" % exc
        _banner(state, state["manual_error"], "warn")
        APP.log("error", state["manual_error"])
        return state
    state["manual_open"] = False
    state["manual_draft"] = {}
    state["manual_error"] = ""
    _banner(state, "已存入 Vault：%s" % asset["title"], "info")
    state["last_action"] = "手动新增：%s" % asset["title"]
    APP.log("info", "manual saved id=%s type=%s" % (asset["id"], asset["type"]))
    return reload_items(state)


def save_ocr(state):
    text = (state.get("ocr_text") or "").strip()
    if not text:
        state["ocr_error"] = "尚未识别到文本，请先选择文件并识别"
        _banner(state, state["ocr_error"], "warn")
        return state
    parsed = dict(state.get("ocr_parsed") or {})
    number = parsed.get("number_full")
    masked = mask_sensitive_text(text)
    if parsed.get("doc_type"):
        fields = {"excerpt": masked, "doc_type": parsed["doc_type"]}
        if parsed.get("valid_from"):
            fields["valid_from"] = parsed["valid_from"]
        if parsed.get("valid_to"):
            fields["valid_to"] = parsed["valid_to"]
        asset_type = "document"
    else:
        fields = {"excerpt": masked}
        asset_type = "image"
    # 落库口径：库内 / 卡片 / 弹层一律只放脱敏文本；识别原文（可能含号码）走 enc 段密文留存，
    # 解锁后方可在详情中查看（与 number_full 同一处理，避免明文号码落盘）。
    sensitive = {}
    if number:
        sensitive["number_full"] = number
    if masked != text:
        sensitive["ocr_text"] = text
    try:
        asset = STORE.add({"type": asset_type, "fields": fields,
                           "sensitive": sensitive,
                           "file_path": state.get("ocr_picked") or None})
    except Exception as exc:
        state["ocr_error"] = "存入失败：%s" % exc
        _banner(state, state["ocr_error"], "warn")
        APP.log("error", state["ocr_error"])
        return state
    state["ocr_open"] = False
    state["ocr_stage"] = "saved"
    state["ocr_error"] = ""
    _banner(state, "OCR 结果已存入 Vault：%s" % asset["title"], "info")
    state["last_action"] = "OCR 录入：%s" % asset["title"]
    APP.log("info", "ocr saved id=%s type=%s" % (asset["id"], asset["type"]))
    return reload_items(state)


def render(state):
    """UI 树由 state 派生；此处只根据 viewport 更新自适应列数（不发 IO）。"""
    width = None
    if isinstance(APP.viewport, dict):
        width = APP.viewport.get("width")
    if not width:
        width = MIN_VIEWPORT_WIDTH
    state["viewport_width"] = int(width)
    state["grid_columns"] = grid_columns_for(width)
    return build_root(state)


def set_filter(state, key):
    if key not in FILTER_LABELS:
        key = "all"
    state["filter"] = key
    reload_items(state)
    state["last_action"] = "筛选：%s（%d 条）" % (FILTER_LABELS[key], state["total"])
    APP.log("info", "filter=%s → %d 条" % (key, state["total"]))
    return state


def set_manual_kind(state, kind):
    if kind not in MANUAL_KINDS:
        kind = "document:身份证"
    state["manual_kind"] = kind
    state["manual_draft"] = {spec["id"]: spec.get("value", "") for spec in manual_specs(kind)}
    state["manual_error"] = ""
    state["last_action"] = "录入类型：%s" % manual_kind_label(kind)
    return state


def on_event(envelope):
    """兜底事件处理：卡片节点 tap（节点 id 带资产 id）、栅格 select、筛选按键、录入类型按键。"""
    state = APP.state
    node_id = envelope.get("node_id") or ""
    event = envelope.get("event")
    payload = envelope.get("payload") or {}
    if node_id.startswith(CARD_PREFIX) and event in ("tap", "select"):
        return open_detail(state, node_id[len(CARD_PREFIX):])
    if node_id == "card_wall" and event in ("tap", "select"):
        aid = _payload_id(payload, state)
        if aid:
            return open_detail(state, aid)
    if node_id.startswith("filt_") and event == "tap":
        return set_filter(state, node_id[len("filt_"):])
    if node_id.startswith("kind_") and event == "tap":
        return set_manual_kind(state, node_id[len("kind_"):])
    APP.log("warn", "未识别的事件 %s@%s" % (node_id, event))
    _banner(state, "未识别的操作：%s@%s" % (node_id, event), "warn")
    return state


APP = brick_sdk.BrickApp(render=render, state=dict(INITIAL_STATE), on_event=on_event,
                         name="vault")


def _on_capability_result(call_id, result, error):
    """能力应答回调：auth.biometric / fs.pick / ocr.recognize 三条链路。"""
    job = CALL_JOBS.pop(call_id, None)
    state = APP.state
    if job is None:
        APP.log("warn", "收到未知能力应答 id=%s" % call_id)
        return
    method, context = job
    if method == "auth.biometric":
        state["detail_unlocking"] = False
        if error:
            message = _error_text(error, "生物识别验证未通过")
            state["detail_auth_error"] = message
            _banner(state, message, "warn")
            APP.log("warn", "auth.biometric 失败：%s" % message)
        elif not (result or {}).get("granted", True):
            message = "验证未通过：未获得生物识别授权"
            state["detail_auth_error"] = message
            _banner(state, message, "warn")
        else:
            plain = STORE.plain_fields(context)
            if plain:
                state["detail_unlocked"] = True
                state["detail_sensitive"] = plain
                state["detail_auth_error"] = ""
                state["last_action"] = "已解锁敏感字段（%s）" % "、".join(
                    SENSITIVE_LABELS.get(k, k) for k in plain)
                APP.log("info", "auth.biometric 通过，解密 %d 个字段" % len(plain))
            else:
                state["detail_auth_error"] = "未找到可解密的敏感字段"
                _banner(state, state["detail_auth_error"], "warn")
    elif method == "fs.pick":
        if error:
            state["ocr_error"] = _error_text(error, "选择文件失败")
            _banner(state, state["ocr_error"], "warn")
            state["ocr_stage"] = "idle"
        else:
            picked = ""
            if isinstance(result, dict):
                picked = result.get("path") or ""
                if not picked:
                    paths = result.get("paths") or []
                    picked = paths[0] if paths else ""
            if not picked:
                state["ocr_error"] = "未选择任何文件"
                _banner(state, state["ocr_error"], "warn")
                state["ocr_stage"] = "idle"
            else:
                state["ocr_picked"] = picked
                state["ocr_error"] = ""
                state["ocr_stage"] = "picked"
                if _require_permission(state, "ocr.recognize", "OCR 识别"):
                    call = APP.call_capability("ocr.recognize",
                                               {"path": picked, "languages": ["zh-Hans", "en"]})
                    CALL_JOBS[call] = ("ocr.recognize", picked)
                    state["ocr_stage"] = "recognizing"
    elif method == "ocr.recognize":
        if error:
            state["ocr_error"] = _error_text(error, "OCR 识别失败")
            _banner(state, state["ocr_error"], "warn")
            state["ocr_stage"] = "picked"
        else:
            text = ""
            if isinstance(result, dict):
                text = result.get("text") or ""
            elif isinstance(result, str):
                text = result
            text = (text or "").strip()
            if not text:
                state["ocr_error"] = "OCR 未识别到文本，可换个更清晰的文件重试"
                _banner(state, state["ocr_error"], "warn")
                state["ocr_stage"] = "picked"
            else:
                parsed = parse_document_fields(text)
                state["ocr_text"] = text
                state["ocr_parsed"] = parsed
                state["ocr_error"] = ""
                state["ocr_stage"] = "ready"
                _banner(state, "OCR 完成：识别 %d 字%s" % (
                    len(text), "，已解析证件字段" if parsed else ""), "info")
                state["last_action"] = "OCR 识别完成"
    APP.push()


