def _locate_sdk_dir():
    """返回含 brick_sdk.py 的目录；找不到返回 None（不内置 SDK 副本，避免包体漂移）。"""
    candidates = []
    env_dir = os.environ.get("SHADELING_BRICK_SDK_DIR")
    if env_dir:
        candidates.append(env_dir)
    candidates.append(HERE)

    current = HERE
    for _ in range(8):
        parent = os.path.dirname(current)
        if not parent or parent == current:
            break
        candidates.append(os.path.join(parent, "sdk", "python"))
        current = parent

    for candidate in candidates:
        if os.path.isfile(os.path.join(candidate, "brick_sdk.py")):
            return candidate
    return None


