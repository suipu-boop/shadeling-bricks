+def _db():
+    return sqlite3.connect(DB)
+
+
+def ITEM_COUNT(title=None):
+    conn = _db()
+    conn.row_factory = sqlite3.Row
+    if title:
+        row = conn.execute("SELECT COUNT(*) c FROM items WHERE title=?", (title,)).fetchone()
+    else:
+        row = conn.execute("SELECT COUNT(*) c FROM items WHERE state='active'").fetchone()
+    conn.close()
+    return row["c"]
+
+
+def STORE_MATERIALS():
+    conn = _db()
+    conn.row_factory = sqlite3.Row
+    rows = conn.execute(
+        "SELECT m.* FROM materials m JOIN items i ON i.id=m.item_id"
+        " WHERE i.title='2026 年度协会科学技术奖申报' ORDER BY m.sort").fetchall()
+    conn.close()
+    return [dict(r) for r in rows]
+
+
+def FILES_OF_ITEM():
+    conn = _db()
+    conn.row_factory = sqlite3.Row
+    rows = conn.execute(
+        "SELECT f.* FROM item_files f JOIN items i ON i.id=f.item_id"
+        " WHERE i.title='2026 年度协会科学技术奖申报'").fetchall()
+    conn.close()
+    return [dict(r) for r in rows]
 
 
