+def _parse_agent_json(text):
+    """从模型输出里取第一个 JSON 对象；失败返回 None。"""
+    if not text:
+        return None
+    cleaned = text.strip()
+    cleaned = re.sub(r"^```(?:json)?", "", cleaned).strip()
+    cleaned = re.sub(r"```$", "", cleaned).strip()
+    start = cleaned.find("{")
+    end = cleaned.rfind("}")
+    if start < 0 or end <= start:
+        return None
+    try:
+        data = json.loads(cleaned[start:end + 1])
+    except ValueError:
+        return None
+    if not isinstance(data, dict):
+        return None
+    materials = data.get("materials")
+    normalized = []
+    if isinstance(materials, list):
+        for mat in materials:
+            if isinstance(mat, str):
+                normalized.append({"name": mat, "required": True})
+            elif isinstance(mat, dict) and mat.get("name"):
+                normalized.append({"name": str(mat["name"]),
+                                   "required": bool(mat.get("required", True))})
+    data["materials"] = normalized
+    return data
+
+
