+def days_left(deadline, base=None):
+    """剩余天数；无期限返回 None。"""
+    date = parse_date(deadline)
+    if date is None:
+        return None
+    return (date - (base or today())).days
+
+
+def urgency_of(deadline, base=None):
+    """紧迫度分级（纯函数，边界见 selftest）。"""
+    days = days_left(deadline, base)
+    if days is None:
+        return "nodate"
+    if days < 0:
+        return "overdue"
+    if days <= 7:
+        return "urgent"
+    if days <= 30:
+        return "soon"
+    return "later"
+
+
+def deadline_line(deadline, base=None):
+    days = days_left(deadline, base)
+    if days is None:
+        return "无期限"
+    if days < 0:
+        return "%s · 逾期 %d 天" % (deadline, -days)
+    if days == 0:
+        return "%s · 今天截止" % deadline
+    return "%s · 剩 %d 天" % (deadline, days)
+
+
+def material_progress(materials):
+    """(已备条数, 总条数, 百分比)；必备未齐时上限 99%。"""
+    total = len(materials)
+    if total == 0:
+        return 0, 0, 0
+    done = len([m for m in materials if m["state"] in ("have", "checked")])
+    pct = int(round(done * 100.0 / total))
+    missing_required = [m for m in materials
+                        if m["required"] and m["state"] == "missing"]
+    if missing_required and pct >= 100:
+        pct = 99
+    return done, total, pct
+
+
